<!-- app/src/debug/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name="com.androdr.debug.ScanBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <!-- Exported for `adb shell am broadcast` (the adversary harness). DUMP is held by the shell and
                 cannot be granted to an ordinary app, so no other app on a test device can start a scan or
                 plant a seed indicator. -->
            <intent-filter>
                <action android:name="com.androdr.ACTION_SCAN" />
                <action android:name="com.androdr.ACTION_UPDATE" />
                <action android:name="com.androdr.ACTION_SEED_CERT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
