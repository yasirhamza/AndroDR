# Known Pegasus artifact paths injected via ADB into /data/local/tmp.
#
# /data/local/tmp is rwxrwx--x: an unprivileged app cannot list it but can look
# up an exact name in it. Until #387 the scanner gave up because the folder
# could not be listed, so this scenario could only demand that the report admit
# it had not looked (#366). The scanner now looks, so detection is what to demand.
Spyware artifact: /data/local/tmp/.raptor
Spyware artifact: /data/local/tmp/.stat
/data/local/tmp/.raptor : FOUND
/data/local/tmp/.stat : FOUND
# ...and a planted path must never be reported as clear. The report renders a
# checked-and-empty path as "<path> : clear" (ReportFormatter FILE ARTIFACT CHECKS).
!/data/local/tmp/.raptor : clear
!/data/local/tmp/.stat : clear
